---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/literata/400.css';
import '@fontsource/literata/400-italic.css';
import '@fontsource/literata/600.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '../styles/base.css';
import { dict, href, LOCALES, DICTS } from '../lib/i18n.mjs';
import { ogSlugForPath, ogFilename } from '../lib/og-slug.mjs';

interface Props { title: string; description?: string; lang?: string; noindex?: boolean }
const { title, lang = 'en', noindex = false } = Astro.props;
const t = dict(lang);
const description = Astro.props.description || t.chrome.metaDescription;

const nav = [
  ['/law', t.chrome.law],
  ['/law/objections', t.chrome.objections],
  ['/law/ledger', t.chrome.ledger],
  ['/simulator', t.chrome.simulator],
  ['/evidence', t.chrome.evidence],
  ['/about', t.chrome.about],
];
// Path of this page with the locale prefix removed, for the switcher and
// hreflang alternates.
const rawPath = Astro.url.pathname.replace(/\.html$/, '');
const basePath = lang === 'en' ? rawPath : (rawPath.replace(new RegExp(`^/${lang}`), '') || '/');
const isCurrent = (navHref: string) => {
  const p = basePath;
  if (navHref === '/law') return p === '/law' || (p.startsWith('/law/') && !p.startsWith('/law/objections') && !p.startsWith('/law/ledger'));
  return p === navHref || p.startsWith(navHref + '/');
};
// Certificate og-image for this page; falls back to the locale's cover
// when the page has no certificate of its own (per-article pages, 404).
const ogImage = new URL(`/og/${ogFilename(lang, ogSlugForPath(basePath))}`, Astro.site).href;
// One canonical URL per page, in this page's own language: the alternates
// below carry the other five. Without it the trailing-slash form a static
// host redirects to would read as a second copy of the same page.
const abs = (l, p) => {
  const path = href(l, p);
  return new URL(path.length > 1 ? path.replace(/\/$/, '') : path, Astro.site).href;
};
const canonical = abs(lang, basePath);
const OG_LOCALE = { en: 'en_GB', nl: 'nl_NL', fr: 'fr_FR', de: 'de_DE', es: 'es_ES' };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: String(Astro.site),
      name: 'Own the Machine',
      inLanguage: lang,
      description,
      publisher: { '@id': `${Astro.site}#org` },
    },
    {
      '@type': 'Organization',
      '@id': `${Astro.site}#org`,
      name: 'Own the Machine',
      url: String(Astro.site),
      logo: new URL('/og/en-index.png', Astro.site).href,
    },
    {
      '@type': 'Legislation',
      '@id': `${Astro.site}#regulation`,
      name: 'Regulation on the participation of citizens of the Union in the capital value created by hyper-automated undertakings',
      legislationType: 'Draft Regulation',
      legislationJurisdiction: 'European Union',
      inLanguage: 'en',
      isBasedOn: 'https://github.com/ownthemachine/own-the-machine',
      license: 'https://creativecommons.org/licenses/by-sa/4.0/',
      author: { '@type': 'Person', name: 'David Vanheeswijck' },
      creativeWorkStatus: 'Draft',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': `${Astro.site}#website` },
      about: { '@id': `${Astro.site}#regulation` },
      primaryImageOfPage: ogImage,
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title.length > 48 ? title : `${title} · Own the Machine`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Own the Machine" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang] || 'en_GB'} />
    {LOCALES.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.chrome.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.chrome.ogImageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#14352A" />
    <!-- Carried by the document, so they survive a move to any host: a bucket
         and a CDN that cannot set response headers still serve these. The
         policy is deliberately narrow — this site fetches nothing, posts
         nothing and embeds nothing from anywhere else. 'unsafe-inline' is
         the honest cost of Astro's scoped <style> blocks and the pre-paint
         theme script; it still forbids loading script from another origin,
         which is the injection route that matters for a static site. -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={abs(l, basePath)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs('en', basePath)} />
    <script is:inline>
      try { var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.chrome.skip}</a>
    <nav aria-label="Primary">
      <a class="brand" href={href(lang, '/')}>OWN&nbsp;THE&nbsp;MACHINE</a>
      <div class="links">
        {nav.map(([navHref, label]) => (
          <a href={href(lang, navHref)} aria-current={isCurrent(navHref) ? 'page' : undefined}>{label}</a>
        ))}
        <span class="langs" role="group" aria-label="Language">
          {LOCALES.map((l) => (
            <a class="lang" href={href(l, basePath)} aria-current={l === lang ? 'true' : undefined}
               hreflang={l} lang={l} title={DICTS[l].name}>{l.toUpperCase()}</a>
          ))}
        </span>
        <button id="theme-toggle" type="button" aria-label={t.chrome.themeToggle} title={t.chrome.themeToggle}>◐</button>
      </div>
    </nav>
    <main id="main"><slot /></main>
    <script is:inline>
      (function () {
        var b = document.getElementById('theme-toggle');
        if (b) b.addEventListener('click', function () {
          var cur = document.documentElement.dataset.theme || '';
          var sysDark = matchMedia('(prefers-color-scheme: dark)').matches;
          var next = cur === 'dark' ? 'light' : cur === 'light' ? 'dark'
                   : (sysDark ? 'light' : 'dark');
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
        // carry the reading position across a language switch
        document.querySelectorAll('a.lang').forEach(function (a) {
          a.addEventListener('click', function () {
            if (location.hash) a.href = a.href.split('#')[0] + location.hash;
          });
        });
      })();
    </script>
    <footer>
      <hr class="rule-fine" />
      <div class="foot-inner">
        <span class="foot-q"><em>{t.chrome.footerQuestion}</em></span>
        <span class="foot-meta">
          {t.chrome.footerDrafted} · <a href="https://github.com/ownthemachine">GitHub</a> ·
          {t.chrome.footerLicence} · {t.chrome.footerPrivacy} · {t.chrome.footerHosting}
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; background: var(--seal-gold); color: var(--paper); padding: 0.5rem 1rem; z-index: 30; }
  .skip:focus { left: 0; }
  nav {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    flex-wrap: wrap; padding: 1.1rem clamp(1rem, 4vw, 3rem);
    border-bottom: 1px solid var(--guilloche);
  }
  .brand {
    font-family: var(--display); font-weight: 600; letter-spacing: 0.14em;
    font-size: 1rem; text-decoration: none;
  }
  .links { display: flex; gap: clamp(0.7rem, 2vw, 1.4rem); flex-wrap: wrap; align-items: baseline; }
  .links a { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; }
  .links a[aria-current="page"] { color: var(--seal-gold); }
  .langs { display: inline-flex; gap: 0.45rem; padding-left: 0.6rem; border-left: 1px solid var(--guilloche); }
  .lang {
    font-size: 0.68rem !important; color: var(--ink-soft); letter-spacing: 0.06em !important;
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 24px; min-height: 24px;
  }
  .lang[aria-current="true"] { color: var(--seal-gold); border-bottom: 1px solid var(--seal-gold); }
  #theme-toggle {
    background: none; border: 1px solid var(--guilloche); color: var(--ink);
    font-size: 0.85rem; line-height: 1; padding: 0.25rem 0.45rem; cursor: pointer;
    border-radius: 50%;
  }
  #theme-toggle:hover { border-color: var(--seal-gold); color: var(--seal-gold); }
  main { padding: clamp(1.5rem, 4vw, 3rem); max-width: 72rem; margin: 0 auto; }
  footer { padding: 1.5rem clamp(1rem, 4vw, 3rem) 2.5rem; }
  .foot-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; padding-top: 0.9rem; }
  .foot-q { font-family: var(--read); }
  .foot-meta { font-size: 0.78rem; color: var(--ink-soft); }
  .foot-meta a { color: var(--ink-soft); }
  @media (max-width: 600px) {
    nav { padding: 0.8rem 1rem; row-gap: 0.4rem; }
    .links { gap: 0.65rem 0.9rem; }
    .links a { font-size: 0.72rem; letter-spacing: 0.05em; }
    .brand { font-size: 0.9rem; }
  }
</style>
