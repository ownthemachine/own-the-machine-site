---
import Base from '../../layouts/Base.astro';
import law from '../../generated/law.json';
import OnPage from '../OnPage.astro';
import LangBanner from '../LangBanner.astro';
import DraftNotice from '../DraftNotice.astro';
import { dict } from '../../lib/i18n.mjs';
interface Props { lang: string }
const { lang } = Astro.props;
const t = dict(lang);
const doc = law.explanatory[lang] || law.explanatory.en;
const isLocal = Boolean(law.explanatory[lang]);
---
<Base title={t.explanatory.title} lang={lang} description={t.explanatory.description}>
  <p class="eyebrow">{t.explanatory.eyebrow}</p>
  <h1>{t.explanatory.title}</h1>
  <p class="intro prose">{t.explanatory.intro}</p>
  <LangBanner lang={lang} doc={law.explanatory[lang]} />
  <DraftNotice lang={lang} />
  <div class="withtoc">
    <OnPage lang={lang} toc={doc.toc} />
    <div class="prose" lang={isLocal ? lang : "en"} set:html={doc.html} />
  </div>
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 0.4rem 0 1rem; }
  .intro { margin-bottom: 2rem; }
</style>
