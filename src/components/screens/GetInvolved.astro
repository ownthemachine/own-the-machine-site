---
import Base from '../../layouts/Base.astro';
import { dict, href } from '../../lib/i18n.mjs';
// English only for now. A grouping page: it only links.
const lang = 'en';
const t = dict(lang);
const g = t.involved;
const items = [['/join', t.join.title], ['/sign', t.sign.title], ['/contribute', t.contribute.title]];
---
<Base title={g.title} lang={lang} enOnly description={g.description}>
  <h1>{g.title}</h1>
  <ul class="group">
    {items.map(([to, label]) => <li><a href={href(lang, to)}>{label}</a></li>)}
  </ul>
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 0.4rem 0 1.2rem; }
  .group { list-style: none; margin: 0; padding: 0; }
  .group li { padding: 0.25rem 0; font-family: var(--read); }
</style>
