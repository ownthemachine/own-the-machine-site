---
import Base from '../../layouts/Base.astro';
import law from '../../generated/law.json';
import { heroSeal } from '../../lib/seal.mjs';
import { dict, fmt, href } from '../../lib/i18n.mjs';
interface Props { lang: string }
const { lang } = Astro.props;
const t = dict(lang);
---
<Base title={t.home.title} lang={lang}>
  <section class="cover">
    <hr class="rule-double" /><hr class="rule-fine" />
    <p class="eyebrow center">{t.home.eyebrow}</p>
    <h1>OWN&nbsp;THE&nbsp;MACHINE</h1>
    <p class="tagline">{t.home.tagline}</p>
    <div class="sealwrap" set:html={heroSeal({ size: 210 })} />
    <p class="ask">{t.home.ask}</p>
    <div class="cta no-print">
      <a class="btn btn-gold" href={href(lang, '/law')}>{t.home.ctaRead}</a>
      <a class="btn" href={href(lang, '/law/objections')}>{t.home.ctaObjections}</a>
    </div>
  </section>

  <section class="three">
    <div>
      <p class="eyebrow">{t.home.col1Head}</p>
      <p>{t.home.col1}</p>
    </div>
    <div>
      <p class="eyebrow">{t.home.col2Head}</p>
      <p>{t.home.col2}</p>
    </div>
    <div>
      <p class="eyebrow">{t.home.col3Head}</p>
      <p set:html={fmt(t.home.col3, { LEDGER: href(lang, '/law/ledger') })} />
    </div>
  </section>

  <p class="declared" set:html={fmt(t.home.declared, { COMMIT: `<span class="serial">${law.lawCommit}</span>` })} />
</Base>

<style>
  .cover { text-align: center; padding-top: 1rem; }
  .cover h1 { font-size: clamp(2rem, 6vw, 3.4rem); letter-spacing: 0.13em; margin: 1rem 0 0.4rem; }
  .center { text-align: center; margin-top: 1rem; }
  .tagline { font-family: var(--read); font-style: italic; color: var(--ink-soft); font-size: 1.1rem; }
  .sealwrap { display: flex; justify-content: center; margin: 1.6rem 0; }
  .ask { font-family: var(--read); font-size: 1.15rem; max-width: 36rem; margin: 0 auto 1.8rem; }
  .cta { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem; }
  .three { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 2rem; border-top: 1px solid var(--guilloche); padding-top: 2rem; }
  .three p { font-size: 0.95rem; margin-top: 0.5rem; }
  .declared { margin-top: 3rem; font-size: 0.8rem; color: var(--ink-soft); max-width: 46rem; }
  :global(.seal-draw) { stroke-dasharray: 4000; stroke-dashoffset: 4000; animation: seal-draw 2.2s ease-out forwards; }
  @keyframes seal-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { :global(.seal-draw) { animation: none; stroke-dashoffset: 0; } }
</style>
