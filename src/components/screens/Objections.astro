---
import Base from '../../layouts/Base.astro';
import law from '../../generated/law.json';
import OnPage from '../OnPage.astro';
import LangBanner from '../LangBanner.astro';
import { dict, fmt, href } from '../../lib/i18n.mjs';
interface Props { lang: string }
const { lang } = Astro.props;
const t = dict(lang);
const doc = law.objections[lang] || law.objections.en;
const isLocal = Boolean(law.objections[lang]);
---
<Base title={t.objections.title} lang={lang} description={t.objections.description}>
  <p class="eyebrow">{t.objections.eyebrow}</p>
  <h1>{t.objections.title}</h1>
  <p class="intro prose" set:html={fmt(t.objections.intro, { LAW: href(lang, '/law') })} />
  <LangBanner lang={lang} doc={law.objections[lang]} />
  <div class="withtoc">
    <OnPage lang={lang} toc={doc.toc} />
    <div class="prose objections" lang={isLocal ? lang : "en"} set:html={doc.html} />
  </div>
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 0.4rem 0 1rem; }
  .intro { margin-bottom: 2rem; }
  .objections :global(h2) { border-top: 1px solid var(--guilloche); padding-top: 1.4rem; }
</style>
