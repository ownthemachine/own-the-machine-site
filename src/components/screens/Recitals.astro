---
import Base from '../../layouts/Base.astro';
import law from '../../generated/law.json';
import LangBanner from '../LangBanner.astro';
import { dict, href } from '../../lib/i18n.mjs';
interface Props { lang: string }
const { lang } = Astro.props;
const t = dict(lang);
---
<Base title={t.lawIndex.recitals} lang={lang}>
  <p class="eyebrow">{t.lawDoc.eyebrowRecitals}</p>
  <h1>{t.lawIndex.recitals}</h1>
  <LangBanner lang={lang} kind="lawEnglish" />
  <p class="whereas" lang="en">Whereas:</p>
  <div class="prose law-text" lang="en" set:html={law.recitals} />
  <nav class="pager no-print" aria-label="Articles">
    <a href={href(lang, '/law')}>{t.chrome.contentsLink}</a>
    <a href={href(lang, '/law/article-1')}>{t.lawIndex.article} 1 &rarr;</a>
  </nav>
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 0.4rem 0 1rem; }
  .whereas { font-family: var(--read); margin-bottom: 1rem; }
  .law-text :global(p) { padding-left: 1.7rem; text-indent: -1.7rem; }
  @media (max-width: 600px) {
    .law-text :global(p) { padding-left: 1.1rem; text-indent: -1.1rem; }
  }
  .pager { display: flex; justify-content: space-between; border-top: 1px solid var(--guilloche); margin-top: 1.6rem; padding-top: 0.9rem; font-size: 0.85rem; }
</style>
