---
import Base from '../../layouts/Base.astro';
import law from '../../generated/law.json';
import { dict, href } from '../../lib/i18n.mjs';
// English, Dutch and French. A grouping page: it only links.
interface Props { lang?: string }
const { lang = 'en' } = Astro.props;
const t = dict(lang);
const e = t.experts;
const c = t.chrome;
// the translated rubric where one exists, the English heading otherwise, as
// on the contents page
const rubric = (item, english) => (item.titles && item.titles[lang]) || english;
const articleItems = [
  ...law.articles.map((a) => [`/law/${a.slug}`, `${t.lawIndex.article} ${a.number}: ${rubric(a, a.title)}`]),
  ...law.annexes.map((a) => [`/law/${a.slug}`, `${t.lawIndex.annex} ${a.numeral}: ${rubric(a, a.title.replace(/^Annex [IVX]+:\s*/, ''))}`]),
];
const groups = [
  [e.startHead, [
    ['/law/registration', c.registration],
    ['/law', e.allOfIt],
    ['/law/objections', t.lawIndex.objectionsLink],
  ]],
  [e.regulationHead, [['/law/recitals', c.recitals]], articleItems],
  [e.memorandumHead, [
    ['/law/explanatory-memorandum', c.explanatory],
    ['/law/memorandum', t.lawIndex.severabilityLink],
  ]],
  [e.evidenceHead, [
    ['/evidence', c.evidence],
    ['/law/ledger', c.ledger],
    ['/law/versions', c.versions],
  ]],
  [e.moreHead, [
    ['/faq', c.faq],
    ['/simulator', c.simulator],
    ['/experts/overview', e.overview],
  ]],
];
---
<Base title={e.title} lang={lang} plainOnly description={e.description}>
  <h1>{e.title}</h1>
  {groups.map(([head, items, folded]) => (
    <section class="group">
      <h2>{head}</h2>
      <ul>
        {items.map(([to, label]) => <li><a href={href(lang, to)}>{label}</a></li>)}
      </ul>
      {folded && (
        <details>
          <summary>{e.allArticles}</summary>
          <ul>
            {folded.map(([to, label]) => <li><a href={href(lang, to)}>{label}</a></li>)}
          </ul>
        </details>
      )}
    </section>
  ))}
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 0.4rem 0 1.2rem; }
  .group { border-top: 1px solid var(--guilloche); padding: 1rem 0; }
  .group h2 { font-size: 1.15rem; margin: 0 0 0.5rem; }
  .group ul { list-style: none; margin: 0; padding: 0; }
  .group summary { cursor: pointer; padding: 0.3rem 0; }
  .group li { padding: 0.15rem 0; font-family: var(--read); }
</style>
