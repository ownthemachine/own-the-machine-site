---
import Base from '../../layouts/Base.astro';
import LangBanner from '../LangBanner.astro';
import law from '../../generated/law.json';
import { dict, href, PLAIN_LOCALES } from '../../lib/i18n.mjs';
interface Props { lang: string }
const { lang } = Astro.props;
const t = dict(lang);
const doc = law.about[lang] || law.about.en;
const isLocal = Boolean(law.about[lang]);
---
<Base title={t.about.title} lang={lang} description={t.about.description}>
  <p class="eyebrow">{t.about.eyebrow}</p>
  <h1>{t.about.title}</h1>
  <LangBanner lang={lang} doc={law.about[lang]} />
    <div class="prose" lang={isLocal ? lang : "en"} set:html={doc.html} />
  {PLAIN_LOCALES.includes(lang) && (
    <ul class="siblings">
      <li><a href={href(lang, '/press')}>{t.chrome.press}</a></li>
      <li><a href={href(lang, '/brief')}>{t.brief.title}</a></li>
    </ul>
  )}
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 0.4rem 0 1.2rem; }
  .prose :global(h2) { font-size: 1.25rem; }
  .siblings { list-style: none; margin: 1.6rem 0 0; padding: 1rem 0 0; border-top: 1px solid var(--guilloche); }
</style>
