---
import Base from '../../layouts/Base.astro';
import lawData from '../../generated/law.json';
import LangBanner from '../LangBanner.astro';
import DraftNotice from '../DraftNotice.astro';
import { dict, fmt, href } from '../../lib/i18n.mjs';
interface Props { lang: string; kind: 'article' | 'annex'; item: any }
const { lang, kind, item } = Astro.props;
const t = dict(lang);
const arts = lawData.articles;
const idx = kind === 'article' ? arts.findIndex((a) => a.number === item.number) : -1;
const prev = idx > 0 ? arts[idx - 1] : null;
const next = idx >= 0 && idx < arts.length - 1 ? arts[idx + 1] : null;
// The rubric is a comprehension aid, like the plain layer: translated where a
// translation exists, so a reader scanning tabs, search results and the
// contents list is not met by twenty English headings. The rubric inside the
// law block stays English, because that block is the authentic text.
const englishRubric = kind === 'article'
  ? item.title : item.title.replace(/^Annex [IVX]+:\s*/, '');
const rubric = (item.titles && item.titles[lang]) || englishRubric;
const localised = rubric !== englishRubric;
const label = kind === 'article'
  ? `${t.lawIndex.article} ${item.number}`
  : `${t.lawIndex.annex} ${item.numeral}`;
const title = `${label}: ${rubric}`;
// one h1 per page: when the translated rubric heads the page, the English one
// inside the law block steps down to h2 rather than competing with it
const Rubric = localised ? 'h2' : 'h1';
// The eyebrow labels the authentic text, so it stays in the language of that
// text: the law block reads English end to end, whatever the page language.
const en = dict('en');
const eyebrow = kind === 'article'
  ? fmt(en.lawDoc.eyebrowArticle, { N: String(item.number) })
  : fmt(en.lawDoc.eyebrowAnnex, { N: item.numeral });
const plain = kind === 'article' && item.plain
  ? (item.plain[lang] || item.plain.en) : null;
// The meta description is a search snippet, not the page. Several L0 lines got
// longer when the plain layer was corrected, because they now state things the
// old ones left out, such as Article 10 not promising a payment every year.
// The page keeps the whole sentence; the tag is trimmed at a word boundary so
// a search engine truncates nothing mid-word.
const metaDescription = (s: string, limit = 160) => {
  if (!s || s.length <= limit) return s;
  const cut = s.slice(0, limit);
  const at = cut.lastIndexOf(' ');
  return `${(at > 60 ? cut.slice(0, at) : cut).replace(/[,;:]$/, '')}…`;
};
---
<Base title={title} lang={lang} description={plain ? metaDescription(plain.l0) : undefined}>
  <article class="lawpage">
    {localised && (
      <header class="rubric">
        <p class="eyebrow">{label}</p>
        <h1>{rubric}</h1>
      </header>
    )}
    <LangBanner lang={lang} kind="lawEnglish" />
    <DraftNotice lang={lang} />
    {plain && (
      <aside class="plain-l1" lang={item.plain[lang] ? lang : 'en'}>
        <p class="plain-label">{t.lawDoc.plainLabel}</p>
        {plain.stale && <LangBanner lang={lang} kind="plainStale" />}
        <p class="plain-l0">{plain.l0}</p>
        <div class="prose" set:html={plain.l1} />
      </aside>
    )}
    <div class="lawblock" lang="en">
      <p class="eyebrow">{eyebrow}</p>
      <Rubric>{englishRubric}</Rubric>
      <div class="prose law-text" set:html={item.html} />
    </div>
    <p class="provenance" set:html={
      fmt(t.lawDoc.provenance, { COMMIT: `<span class="serial">${lawData.lawCommit}</span>` }) +
      ` · <a href="https://github.com/ownthemachine/own-the-machine/commits/main">${t.chrome.historyLink}</a>` +
      ` · <a href="${href(lang, '/law/ledger')}">${t.chrome.reviewLink}</a>`
    } />
    <nav class="pager no-print" aria-label="Articles">
      {prev
        ? <a href={href(lang, `/law/${prev.slug}`)}>&larr; {t.lawIndex.article} {prev.number}</a>
        : <a href={href(lang, '/law/recitals')} set:html={t.lawDoc.prevRecitals} />}
      <a href={href(lang, '/law')}>{t.chrome.contentsLink}</a>
      {next
        ? <a href={href(lang, `/law/${next.slug}`)}>{t.lawIndex.article} {next.number} &rarr;</a>
        : <a href={href(lang, `/law/${lawData.annexes[0].slug}`)} set:html={t.lawDoc.nextAnnex} />}
    </nav>
  </article>
</Base>

<style>
  .lawpage h1 { font-size: 1.7rem; margin: 0.4rem 0 1.2rem; }
  /* The translated rubric heads the page; the English one below it keeps the
     same size but a quieter colour, so the eye reads them as one heading in
     two languages rather than as two competing headlines. */
  .rubric { margin-bottom: 1.4rem; }
  .rubric h1 { margin-bottom: 0.2rem; }
  .lawblock h2 { font-size: 1.7rem; margin: 0.4rem 0 1.2rem; color: var(--ink-soft); }
  /* The law block: one uninterrupted stretch of authentic English text,
     marked by the seal rule so the eye can tell law from commentary. */
  .lawblock { border-top: 2px solid var(--seal-gold); padding-top: 1rem; margin-top: 2rem; }
  .plain-l0 { font-family: var(--read); font-style: italic; font-size: 1.05rem; color: var(--ink-soft); margin: 0 0 0.7rem; max-width: var(--measure); }
  .plain-l1 { border: 1px solid var(--guilloche); border-left: 3px solid var(--ink-soft); background: var(--card); padding: 0.9rem 1.1rem; margin-bottom: 1.4rem; max-width: var(--measure); }
  .plain-label { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 0.5rem; font-family: var(--ui); }
  .plain-l1 .prose p { margin-bottom: 0; font-size: 0.98rem; }
  .law-text :global(p) { padding-left: 1.5rem; text-indent: -1.5rem; }
  @media (max-width: 600px) {
    .law-text :global(p) { padding-left: 1rem; text-indent: -1rem; }
  }
  .provenance { margin-top: 2rem; font-size: 0.78rem; color: var(--ink-soft); }
  .pager { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--guilloche); margin-top: 1.4rem; padding-top: 0.9rem; font-size: 0.85rem; }
</style>
