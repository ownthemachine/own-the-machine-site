---
import Base from '../layouts/Base.astro';
import law from '../generated/law.json';
import OnPage from '../components/OnPage.astro';
---
<Base title="Evidence" description="The numbers behind the draft, ranked, sourced, including the citations we tell you not to use.">
  <p class="eyebrow">Sourced, ranked, and honest about the gaps</p>
  <h1>Evidence</h1>
  <p class="intro prose">
    The European evidence base behind the draft, with sources, and a
    dead-citations list: numbers that circulate in this debate that we
    checked and will not use, including some that would have helped us.
  </p>
  <div class="withtoc">
    <OnPage toc={law.evidence.toc} />
    <div class="prose" set:html={law.evidence.html} />
  </div>
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 0.4rem 0 1rem; }
  .intro { margin-bottom: 2rem; }
</style>
