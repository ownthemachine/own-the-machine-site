---
import Base from '../../layouts/Base.astro';
import law from '../../generated/law.json';
import { commitSeal } from '../../lib/seal.mjs';
const gateNames = {
  'legal-form': 'Legal form',
  'dc-compliance': 'Design constraints',
  'legal-basis': 'Legal basis',
  'hostile-counsel': 'Hostile counsel',
  'acquis-coherence': 'Acquis coherence',
  'layer-fidelity': 'Layer fidelity',
};
---
<Base title="The ledger" description="The public change history of the draft: every adversarial review, every verdict, every editor disposition.">
  <p class="eyebrow">The law shows its work</p>
  <h1>The ledger</h1>
  <div class="intro prose">
    <p>Before any text of this Regulation merges, it passes six
    adversarial gates: legal form, design-constraint compliance, legal
    basis, hostile counsel, coherence with existing EU law, and fidelity
    between the plain-language and legal layers.</p>
    <p>Every verdict is committed to the repository, including the ones
    that drew blood. A REVISE verdict merges only with a written editor
    disposition. Reviews are run adversarially by AI under the editor's
    responsibility; the dispositions below are the editor's, on the
    record.</p>
    <p>Each entry wears a seal derived from its commit hash: no two
    amendments carry the same mark.</p>
  </div>

  {law.ledger.map((e) => (
    <article class="entry" id={e.file.replace('.md', '')}>
      <div class="seal" set:html={commitSeal(e.commit || e.file)} />
      <div class="body">
        <p class="serial">Nº {e.commit || '·'} · {e.date}</p>
        <h2>{gateNames[e.gate] || e.gate} <span class:list={['verdict', { publish: e.verdict === 'PUBLISH' }]}>{e.verdict}{e.disposition ? ` · ${e.disposition.replace(/-/g, ' ')}` : ''}</span></h2>
        <p class="target">{e.target}</p>
        {e.dispositionHtml && (
          <details>
            <summary>Editor disposition</summary>
            <div class="prose dispo" set:html={e.dispositionHtml} />
          </details>
        )}
        <p class="links">
          <a href={`https://github.com/ownthemachine/own-the-machine/blob/main/pipeline/reviews/${e.file}`}>full review</a>
          {e.commit && <> · <a href={`https://github.com/ownthemachine/own-the-machine/commit/${e.commit}`}>diff</a></>}
        </p>
      </div>
    </article>
  ))}
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 0.4rem 0 1rem; }
  .intro { margin-bottom: 2rem; }
  .entry { display: flex; gap: 1.1rem; border: 1px solid var(--guilloche); background: var(--card); padding: 1rem 1.2rem; margin-bottom: 0.8rem; }
  .entry .seal { flex: 0 0 auto; }
  .entry h2 { font-family: var(--ui); font-weight: 600; font-size: 0.98rem; margin: 0.15rem 0 0.3rem; display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .target { font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 0.4rem; }
  details { margin: 0.4rem 0; }
  summary { cursor: pointer; font-size: 0.85rem; }
  .dispo { font-size: 0.9rem; margin-top: 0.6rem; }
  .links { font-size: 0.8rem; }
</style>
