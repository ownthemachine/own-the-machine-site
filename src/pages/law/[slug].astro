---
import law from '../../generated/law.json';
import LawDoc from '../../components/screens/LawDoc.astro';

export function getStaticPaths() {
  return [
    ...law.articles.map((a) => ({ params: { slug: a.slug }, props: { kind: 'article', item: a } })),
    ...law.annexes.map((a) => ({ params: { slug: a.slug }, props: { kind: 'annex', item: a } })),
  ];
}
const { kind, item } = Astro.props;
---
<LawDoc lang="en" kind={kind} item={item} />
