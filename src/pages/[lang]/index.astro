---
import Home from '../../components/screens/Home.astro';

// Dutch and French have the plain home (src/pages/nl and src/pages/fr); this
// page keeps the full home for the languages that have not moved yet.
export function getStaticPaths() {
  return ['de', 'es'].map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
---
<Home lang={lang} />
